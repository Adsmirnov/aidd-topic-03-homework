# Copy this file to .env and fill in the values. .env is not committed.

# Any long random string, e.g. the output of:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
# Host port of the PostgreSQL container (change it if 5432 is taken)
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# T-Invest API token. A read-only token is enough:
# https://www.tbank.ru/invest/settings/api/
TINKOFF_TOKEN=
# T-Invest API address (the legacy invest-public-api.tinkoff.ru also works)
TINKOFF_API_TARGET=invest-public-api.tbank.ru:443
# Used by t-tech-investments >= 1.49.2: verify TLS against the Russian Trusted
# Root CA bundled with the SDK, without installing it into the OS.
# The currently installed tinkoff-investments 0.2.0b117 ignores it.
SSL_TBANK_VERIFY=True
# Root CA for T-Invest API, used by this app's gRPC only (see certs/README.md).
# Empty value disables it (then the API is unreachable without the root in the OS).
TINKOFF_CA_FILE=certs/russian_trusted_root_ca.pem

# Interval of the price refresh by Celery beat, seconds
PRICE_UPDATE_INTERVAL=10
