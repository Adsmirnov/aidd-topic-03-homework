# Copy this file to .env and fill in the values. .env is not committed.

# Any long random string, e.g. the output of:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
# Host port of the PostgreSQL container (change it if 5432 is taken)
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# T-Invest API token. A read-only token is enough:
# https://www.tbank.ru/invest/settings/api/
TINKOFF_TOKEN=
